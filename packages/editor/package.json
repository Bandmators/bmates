{
  "name": "@bmates/editor",
  "version": "0.0.5",
  "description": "web audio editor",
  "author": "kyechan99 <kyechan99@gmail.com>",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
